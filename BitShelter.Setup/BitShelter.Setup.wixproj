<Project Sdk="WixToolset.Sdk/5.0.2">
  <!-- Per-machine MSI: installs the BitShelter Windows service (LocalSystem, auto start) and the elevated tray Agent.
       Build: dotnet build BitShelter.Setup -c Release. It publishes both apps framework-dependent for win-x64 first. -->
  <PropertyGroup>
    <OutputName>BitShelter-$(Version)-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- Directory.Build.props sets portable for C#; wix.exe accepts only full or none. -->
    <DebugType>full</DebugType>
    <PayloadDir>$(MSBuildProjectDirectory)\obj\payload\</PayloadDir>
    <DefineConstants>ProductVersion=$(Version);PayloadDir=$(PayloadDir);AgentProjectDir=$(MSBuildProjectDirectory)\..\BitShelter.Agent\</DefineConstants>
    <HarvestDirectoryAutogenerateGuids>true</HarvestDirectoryAutogenerateGuids>
    <HarvestDirectoryNoLogo>true</HarvestDirectoryNoLogo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Heat" />
    <PackageReference Include="WixToolset.Netfx.wixext" />
    <PackageReference Include="WixToolset.UI.wixext" />
    <PackageReference Include="WixToolset.Util.wixext" />
  </ItemGroup>

  <ItemGroup>
    <HarvestDirectory Include="$(PayloadDir)">
      <ComponentGroupName>PayloadComponents</ComponentGroupName>
      <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
      <PreprocessorVariable>var.PayloadDir</PreprocessorVariable>
      <SuppressRootDirectory>true</SuppressRootDirectory>
      <SuppressRegistry>true</SuppressRegistry>
      <SuppressCom>true</SuppressCom>
      <Transforms>ExcludeExecutables.xslt</Transforms>
    </HarvestDirectory>
  </ItemGroup>

  <Target Name="PublishPayload" BeforeTargets="HarvestDirectory;BeforeBuild">
    <RemoveDir Directories="$(PayloadDir)" />
    <MSBuild Projects="..\BitShelter.Service\BitShelter.Service.csproj;..\BitShelter.Agent\BitShelter.Agent.csproj"
             Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);Platform=x64;RuntimeIdentifier=win-x64;SelfContained=false;PublishDir=$(PayloadDir)" />
    <!-- The licenses of BitShelter and of the bundled third-party components must ship with the binaries. -->
    <Copy SourceFiles="..\LICENSE" DestinationFiles="$(PayloadDir)LICENSE.txt" />
    <Copy SourceFiles="..\THIRD-PARTY-NOTICES.txt" DestinationFolder="$(PayloadDir)" />
  </Target>
</Project>
